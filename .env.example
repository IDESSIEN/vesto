# Supabase Credentials for Advance Modern Agrarian Capital
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Agora Stablecoin API — cross-border USD/USDC ↔ Monad settlement
# Create keys at https://agora.finance (Dashboard → API keys)
#
# Recommended (production): deploy supabase/functions/agora, set secret AGORA_API_KEY, then:
# VITE_AGORA_API_BASE=https://YOUR_PROJECT.supabase.co/functions/v1/agora
#
# Local dev: leave VITE_AGORA_API_BASE unset — Vite proxies /agora → api.agora.finance.
# Optional local demo with a key in the browser (not for production):
# VITE_AGORA_API_KEY=
# VITE_AGORA_API_BASE=
